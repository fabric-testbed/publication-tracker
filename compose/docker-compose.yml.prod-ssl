# compose/docker-compose.yml.prod-ssl
# - nginx port 8080, 8443 exposed to host (http, https) - self signed certs by default

services:

  django:
    # default port 8000
    build:
      context: ./
      dockerfile: Dockerfile
    container_name: pubtrkr-django
    networks:
      - pubtrkr-network
#    ports:
#      - "8000:8000"
    depends_on:
      - database
    # /code is the host's git checkout. It is read-only here so that a boot cannot write
    # into it -- which it used to, as root: a .venv/, a re-resolved uv.lock and
    # collectstatic output all landed in the deploy checkout (#31 finding 9). The two
    # directories the app genuinely writes get their own read-write sub-mounts, and
    # nothing else on the checkout is writable at all.
    volumes:
      - ./:/code:ro
      - ./static:/code/static
      - ./media:/code/media
    # UWSGI_UID/UWSGI_GID are gone: the container runs as appuser (uid 20049) from the
    # image, so uwsgi has nothing to drop to. They still apply to run_server.sh's
    # local-ssl mode on a workstation, and stay documented in env.template.
    environment:
      - LOAD_FIXTURES=${LOAD_FIXTURES:-0}
    restart: unless-stopped

  cron:
    # user-sync sidecar (issue #23). Reuses the django image and the same ./:/code
    # mount so it picks up the identical .env, but overrides ENTRYPOINT: the default
    # docker-entrypoint.sh runs migrations, collectstatic and a second uwsgi.
    build:
      context: ./
      dockerfile: Dockerfile
    container_name: pubtrkr-cron
    entrypoint: ["/code/docker-entrypoint-cron.sh"]
    # The only service that overrides the image's USER. cron -f has to start as root to
    # read /etc/cron.d and to su to the job's user; the sync itself drops to appuser in
    # docker-entrypoint-cron.sh, so the work does not run privileged.
    user: root
    networks:
      - pubtrkr-network
    depends_on:
      - database
      - django
    # Read-only, with no sub-mounts: this container reads .env and the scripts and
    # writes nothing outside the database.
    volumes:
      - ./:/code:ro
    restart: unless-stopped

  database:
    # default port 5432
    image: postgres:15
    container_name: pubtrkr-database
    networks:
      - pubtrkr-network
#    ports:
#      - "5432:5432"
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      PGDATA: ${PGDATA}
    volumes:
      - ${HOST_DB_DATA}:/var/lib/postgresql/data
    restart: unless-stopped

  nginx:
    # default port 8080, 8443
    image: nginx:1
    container_name: pubtrkr-nginx
    networks:
      - pubtrkr-network
    ports:
      - "${NGINX_HTTP_PORT:-8080}:80"
      - "${NGINX_HTTPS_PORT:-8443}:443"
    volumes:
      # nginx only ever reads static/ and media/ from the checkout.
      - .:/code:ro
      - ${NGINX_DEFAULT_CONF}:/etc/nginx/conf.d/default.conf
      - ${NGINX_NGINX_CONF}:/etc/nginx/nginx.conf
      - ${NGINX_SSL_CERTS_DIR}:/etc/ssl:ro
    restart: unless-stopped

  vouch-proxy:
    # default port 9090
    container_name: pubtrkr-vouch-proxy
    image: fabrictestbed/vouch-proxy:0.27.1
    networks:
      - pubtrkr-network
#    ports:
#      - "127.0.0.1:9090:9090"
    volumes:
      - ./vouch:/config
    restart: unless-stopped

networks:
  pubtrkr-network:
    name: pubtrkr-network
    driver: bridge